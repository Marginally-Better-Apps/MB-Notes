  "id": "lined",
  "name": "College Ruled",
  "category": "Lined",
  "background": "#FFFDF7",
  "parameters": {
   "spacing": {
    "label": "Line spacing",
    "default": 22,
    "min": 14,
    "max": 40,
    "step": 1
   },
   "margin": {
    "label": "Margin",
    "default": 72,
    "min": 0,
    "max": 160,
    "step": 4
   }
  },
  "layers": [
   {
    "type": "hlines",
    "spacing": "$spacing",
    "top": "$spacing * 4",
    "color": "#A9C7E8",
    "lineWidth": 0.7
   },
   {
    "type": "line",
    "x1": "$margin",
    "y1": 0,
    "x2": "$margin",
    "y2": "100%",
    "color": "#F2A0A0",
    "lineWidth": 1
   }
  ]
 },
